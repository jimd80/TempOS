#!/usr/bin/env python3
import os
import sys
import re
import time
import shutil
import urllib.request
import subprocess
import hashlib
import threading
import tkinter as tk
from tkinter import ttk, scrolledtext, messagebox

script_dir = os.path.dirname(os.path.abspath(__file__))
if script_dir not in sys.path:
    sys.path.insert(0, script_dir)

from libtempos.utils import run_cmd, to_mb
from libtempos.StorageInfo import StorageInfo
from libtempos.update_logic import check_online_update

class InstallTemposApp(tk.Tk):
    def __init__(self):
        super().__init__()
        
        # Ensure /media/user folder exists and has user permissions
        if not os.path.exists("/media/user"):
            run_cmd("mkdir -p /media/user", as_root=True)
        run_cmd("chown 1000:1000 /media/user", as_root=True)
        run_cmd("chmod 775 /media/user", as_root=True)

        # 1. Initialize StorageInfo
        self.storage = StorageInfo()
        self.brand_name = self.storage.TempOs_Brand_Name
        self.image_name = self.storage.tempos_image
        self.image_no_ext = os.path.splitext(self.image_name)[0] if self.image_name else ""
        self.mount_point_dest = self.storage.mount_point_install

        # 2. Detect Boot ISO Device & ISO Size
        self.boot_main_device = self.storage.boot_direct_iso_device

        self.iso_size = 0
        if self.boot_main_device:
            iso_size_str = run_cmd(["isosize", self.boot_main_device], as_root=True)
            if iso_size_str:
                m = re.search(r'\b(\d+)\b', iso_size_str)
                if m:
                    self.iso_size = int(m.group(1))

        if not self.boot_main_device or self.iso_size <= 0:
            self.withdraw()
            messagebox.showinfo(self.brand_name, "This tool can only be used if booted directly from iso image")
            self.destroy()
            sys.exit(0)

        self.min_required_bytes = int(self.iso_size * 2.5)

        # 3. Window setup
        self.title(f"Install {self.brand_name}")
        ws, hs = self.winfo_screenwidth(), self.winfo_screenheight()
        w, h = 880, 700
        x, y = int((ws - w) / 2), int((hs - h) / 2)
        self.geometry(f"{w}x{h}+{x}+{y}")
        self.minsize(750, 600)
        
        # State variables
        self.install_drives_map = []
        self.install_seq = None
        self.is_installing = False
        self.online_update_info = None
        
        self._build_ui()
        self._refresh_drives()
        
        # Async check for online version on startup
        threading.Thread(target=self._check_online_update_async, daemon=True).start()

    def _format_size(self, size_bytes):
        if size_bytes <= 0:
            return "0 MB"
        sz_mb = size_bytes // (1024 * 1024)
        if sz_mb >= 1024:
            return f"{sz_mb / 1024:.1f} GB"
        return f"{sz_mb} MB"

    def _check_online_update_async(self):
        default_ini = os.path.join(self.storage.asset_folder, "TempOS.ini.default")
        update_url = ""
        if os.path.exists(default_ini):
            try:
                with open(default_ini, 'r') as f:
                    for line in f:
                        line_s = line.strip()
                        if line_s.lower().startswith("updateurl="):
                            update_url = line_s.split("=", 1)[1].strip()
                            break
            except Exception:
                pass

        if update_url:
            try:
                updates = check_online_update(update_url)
                if updates:
                    def _sort_key(s):
                        return re.sub(r'(\d+)', lambda m: m.group(1).zfill(10), str(s))
                    updates.sort(key=lambda x: _sort_key(x['name']), reverse=True)
                    latest = updates[0]
                    self.after(0, self._on_online_check_success, latest)
                    return
            except Exception:
                pass

        self.after(0, self._on_online_check_failed)

    def on_check_online_version(self):
        self.btn_check_online.config(state='disabled')
        self.rb_online.config(text="Online install (Checking for update...)")
        threading.Thread(target=self._check_online_update_async, daemon=True).start()

    def _on_online_check_success(self, latest_update):
        self.online_update_info = latest_update
        self.btn_check_online.pack_forget()
        self.rb_online.config(
            text=f"Online install latest version {latest_update['name']} (large download!)"
        )

    def _on_online_check_failed(self):
        self.online_update_info = None
        self.btn_check_online.config(state='normal')
        self.btn_check_online.pack(side='right')
        self.rb_online.config(
            text="Online install (Could not connect to update server)"
        )

    def _build_ui(self):
        pad = {'padx': 10, 'pady': 5}
        
        # Header Frame: Title on Left, Button [Check online version] on Right
        frm_header = ttk.Frame(self)
        frm_header.pack(fill='x', padx=10, pady=(10, 5))
        
        lbl_title = ttk.Label(
            frm_header,
            text=f"Install {self.brand_name} to USB or Fixed drive",
            font=("TkDefaultFont", 13, "bold")
        )
        lbl_title.pack(side='left')

        self.btn_check_online = ttk.Button(
            frm_header,
            text="Check online version",
            command=self.on_check_online_version
        )
        # Not packed initially, only shown after online check fails
        
        # 1. Source Selection Frame
        frm_source = ttk.LabelFrame(self, text="Installation Source")
        frm_source.pack(fill='x', **pad)
        
        self.var_source_mode = tk.StringVar(value="offline")
        
        sz_str = self._format_size(self.iso_size)
        rb_offline = ttk.Radiobutton(
            frm_source,
            text=f"Offline install [{self.image_no_ext}] ({sz_str})",
            variable=self.var_source_mode,
            value="offline"
        )
        rb_offline.pack(anchor='w', padx=10, pady=3)
        
        self.rb_online = ttk.Radiobutton(
            frm_source,
            text="Online install (Checking for update...)",
            variable=self.var_source_mode,
            value="online"
        )
        self.rb_online.pack(anchor='w', padx=10, pady=3)
        
        # 2. Destination Frame
        frm_dest = ttk.LabelFrame(self, text="Destination Drive")
        frm_dest.pack(fill='x', **pad)
        
        f_dest_top = ttk.Frame(frm_dest)
        f_dest_top.pack(fill='x', padx=5, pady=2)
        
        ttk.Label(f_dest_top, text="Select destination drive:").pack(side='left')
        self.btn_refresh = ttk.Button(f_dest_top, text="Refresh Drives", command=self._refresh_drives)
        self.btn_refresh.pack(side='right')
        
        cols = ("device", "type", "size", "volume")
        self.tv_dest = ttk.Treeview(frm_dest, columns=cols, show='headings', height=5, selectmode='browse')
        self.tv_dest.heading("device", text="Device")
        self.tv_dest.column("device", width=100)
        self.tv_dest.heading("type", text="Type")
        self.tv_dest.column("type", width=130)
        self.tv_dest.heading("size", text="Size")
        self.tv_dest.column("size", width=110, anchor='e')
        self.tv_dest.heading("volume", text="Volume")
        self.tv_dest.column("volume", width=250)
        self.tv_dest.pack(fill='x', padx=5, pady=5)
        self.tv_dest.bind('<<TreeviewSelect>>', self._validate_controls)
        
        # 3. Warnings and Confirmation Frame
        frm_confirm = ttk.LabelFrame(self, text="Confirmation")
        frm_confirm.pack(fill='x', **pad)
        
        self.lbl_wipe_warn = ttk.Label(
            frm_confirm,
            text="WARNING: The entire selected drive will be wiped!",
            foreground="red",
            font=("TkDefaultFont", 9, "bold")
        )
        self.lbl_wipe_warn.pack(anchor='w', padx=10, pady=(4, 2))
        
        self.lbl_error_warn = ttk.Label(
            frm_confirm,
            text="",
            foreground="red",
            font=("TkDefaultFont", 9, "bold")
        )
        
        self.lbl_fixed_warn = ttk.Label(
            frm_confirm,
            text="WARNING: You selected an INTERNAL HARD DRIVE! Overwriting existing operating system and all data!",
            foreground="red",
            font=("TkDefaultFont", 9, "bold")
        )
        
        f_conf_in = ttk.Frame(frm_confirm)
        f_conf_in.pack(fill='x', padx=10, pady=5)
        
        ttk.Label(f_conf_in, text="Type ERASE in uppercase to confirm:").pack(side='left', padx=(0, 5))
        self.ent_erase = ttk.Entry(f_conf_in, width=12)
        self.ent_erase.pack(side='left', padx=5)
        self.ent_erase.bind('<KeyRelease>', self._validate_controls)
        
        self.btn_install = ttk.Button(
            f_conf_in,
            text="Start Installation",
            command=self.on_start_install,
            state='disabled'
        )
        self.btn_install.pack(side='left', padx=15)
        
        self.btn_close = ttk.Button(f_conf_in, text="Close", command=self.on_close)
        self.btn_close.pack(side='right', padx=5)
        
        # 4. Log Output Frame
        frm_log = ttk.LabelFrame(self, text="Installation Progress")
        frm_log.pack(fill='both', expand=True, **pad)
        
        self.txt_log = scrolledtext.ScrolledText(frm_log, wrap=tk.WORD, font=("Consolas", 10))
        self.txt_log.pack(expand=True, fill='both', padx=5, pady=5)
        self.txt_log.tag_config("ERROR", foreground="red")
        self.txt_log.tag_config("SUCCESS", foreground="green")
        self.txt_log.tag_config("INFO", foreground="black")

    def log_message(self, status, msg, replace=False):
        if replace:
            self.txt_log.delete("end-2l", "end-1c")
        tag = status if status in ["ERROR", "SUCCESS", "INFO"] else "INFO"
        self.txt_log.insert(tk.END, f"[{status}] {msg}\n", tag)
        self.txt_log.see(tk.END)
        self.update()

    def _refresh_drives(self):
        for item in self.tv_dest.get_children():
            self.tv_dest.delete(item)
            
        self.install_drives_map = []
        self.storage.refresh()

        for d in self.storage.drives:
            dev_name = d['MainDevice'].replace("/dev/", "")
            is_boot = (d['MainDevice'] == self.boot_main_device)
            if is_boot:
                dtype = "Booted device"
            else:
                dtype = "Removable" if d.get('IsRemovable') else "Internal HD"
            sz_bytes = int(d.get('Size') or 0)
            size_str = self._format_size(sz_bytes)
            vol = d.get('VolumeNames', '')
            
            self.install_drives_map.append(d)
            self.tv_dest.insert('', 'end', values=(dev_name, dtype, size_str, vol))
            
        self._validate_controls()

    def _validate_controls(self, event=None):
        if self.is_installing:
            self.btn_install.config(state='disabled')
            self.btn_refresh.config(state='disabled')
            self.btn_close.config(state='disabled')
            self.ent_erase.config(state='disabled')
            return

        sel = self.tv_dest.selection()
        if not sel:
            self.lbl_error_warn.pack_forget()
            self.lbl_fixed_warn.pack_forget()
            self.btn_install.config(state='disabled')
            return

        idx = self.tv_dest.index(sel[0])
        drive = self.install_drives_map[idx]
        
        is_boot = (drive['MainDevice'] == self.boot_main_device)
        sz_bytes = int(drive.get('Size') or 0)
        is_too_small = (sz_bytes < self.min_required_bytes)
        
        if is_boot:
            self.lbl_error_warn.config(text="ERROR: Cannot install to the currently booted drive!")
            if not self.lbl_error_warn.winfo_ismapped():
                self.lbl_error_warn.pack(anchor='w', padx=10, pady=(0, 2), before=self.ent_erase.master)
            self.lbl_fixed_warn.pack_forget()
            self.btn_install.config(state='disabled')
            return
            
        if is_too_small:
            drive_sz_str = self._format_size(sz_bytes)
            req_sz_str = self._format_size(self.min_required_bytes)
            self.lbl_error_warn.config(
                text=f"ERROR: Drive capacity too small ({drive_sz_str})! Minimum required: {req_sz_str}"
            )
            if not self.lbl_error_warn.winfo_ismapped():
                self.lbl_error_warn.pack(anchor='w', padx=10, pady=(0, 2), before=self.ent_erase.master)
            self.lbl_fixed_warn.pack_forget()
            self.btn_install.config(state='disabled')
            return

        # Drive is valid for installation
        self.lbl_error_warn.pack_forget()
        
        if not drive.get('IsRemovable'):
            if not self.lbl_fixed_warn.winfo_ismapped():
                self.lbl_fixed_warn.pack(anchor='w', padx=10, pady=(0, 2), before=self.ent_erase.master)
        else:
            self.lbl_fixed_warn.pack_forget()
            
        text_is_erase = (self.ent_erase.get().strip() == "ERASE")
        if text_is_erase:
            self.btn_install.config(state='normal')
        else:
            self.btn_install.config(state='disabled')

    def on_close(self):
        if self.is_installing:
            messagebox.showwarning("Busy", "Installation is in progress. Please wait.")
            return
        self.destroy()
        sys.exit(0)

    def on_start_install(self):
        sel = self.tv_dest.selection()
        if not sel:
            return
            
        idx = self.tv_dest.index(sel[0])
        drive = self.install_drives_map[idx]
        mode = self.var_source_mode.get()
        
        if drive['MainDevice'] == self.boot_main_device:
            messagebox.showerror("Error", "Cannot install to the currently booted drive.")
            return
            
        sz_bytes = int(drive.get('Size') or 0)
        if sz_bytes < self.min_required_bytes:
            messagebox.showerror("Error", "Selected drive capacity is too small.")
            return
            
        main_dev = drive['MainDevice']
        sz_str = self._format_size(sz_bytes)
        vol = drive.get('VolumeNames', '')
        
        if drive.get('IsRemovable'):
            msg = f"Are you sure you want to install to {main_dev} ({sz_str} {vol})?\n\nTHIS WILL ERASE ALL DATA ON THE DRIVE!"
        else:
            msg = (
                f"You have selected an INTERNAL HARD DRIVE ({main_dev}, {sz_str}).\n\n"
                "THIS WILL COMPLETELY ERASE THE HARD DRIVE AND OVERWRITE ALL EXISTING OPERATING SYSTEMS AND DATA.\n\n"
                "Are you absolutely sure you want to proceed?"
            )
            
        if not messagebox.askyesno("Confirm Erase & Install", msg, icon='warning'):
            return

        self.is_installing = True
        self._validate_controls()
        
        self.txt_log.insert(tk.END, "--- Starting Installation ---\n", "INFO")
        self.txt_log.see(tk.END)
        
        self.install_seq = self._run_installation(drive, mode)
        self.after(10, self._process_install_step)

    def _process_install_step(self):
        try:
            status, msg, replace = next(self.install_seq)
            self.log_message(status, msg, replace)
            
            if status == "ERROR":
                self._finish_install(success=False)
                return
            elif status == "SUCCESS":
                self._finish_install(success=True)
                return
                
            self.after(10, self._process_install_step)
        except StopIteration:
            self._finish_install(success=True)
        except Exception as e:
            self.log_message("ERROR", f"Unexpected error: {e}")
            self._finish_install(success=False)

    def _finish_install(self, success):
        self.is_installing = False
        self.txt_log.insert(tk.END, "--- Installation Finished ---\n", "INFO")
        self.txt_log.see(tk.END)
        self.btn_close.config(state='normal')
        self.btn_refresh.config(state='normal')
        self.ent_erase.config(state='normal')
        self._refresh_drives()
        
        if success:
            messagebox.showinfo("Installation Complete", "Installation completed successfully.")

    def _download_with_progress(self, url, dest, msg_prefix):
        req = urllib.request.Request(url, headers={'User-Agent': 'TempOsInstall/1.0'})
        with urllib.request.urlopen(req) as response:
            total_size = int(response.info().get('Content-Length', 0))
            chunk_size = 1024 * 256
            bytes_done = 0
            last_yield = 0
            
            with open(dest, 'wb') as f:
                while True:
                    chunk = response.read(chunk_size)
                    if not chunk:
                        break
                    f.write(chunk)
                    bytes_done += len(chunk)
                    
                    now = time.time()
                    if now - last_yield >= 1.0:
                        mb_done = bytes_done // (1024 * 1024)
                        if total_size > 0:
                            pct = (bytes_done * 100 // total_size)
                            mb_total = total_size // (1024 * 1024)
                            yield f"{msg_prefix}: {mb_done} MB of {mb_total} MB ({pct}%)", True
                        else:
                            yield f"{msg_prefix}: {mb_done} MB downloaded", True
                        last_yield = now

    def _verify_file_sha256(self, file_path, expected_hash):
        try:
            sha = hashlib.sha256()
            with open(file_path, 'rb') as f:
                while True:
                    chunk = f.read(1048576)
                    if not chunk:
                        break
                    sha.update(chunk)
            actual = sha.hexdigest().lower()
            return (actual == expected_hash.lower()), actual
        except Exception as e:
            return False, str(e)

    def _run_installation(self, dest_drive, mode):
        main_device = dest_drive['MainDevice']
        dest_mount = self.mount_point_dest
        dest_ventoy_dir = os.path.join(dest_mount, "ventoy")
        dest_ventoy_json = os.path.join(dest_ventoy_dir, "ventoy.json")
        brand_dir = os.path.join(dest_mount, self.brand_name)
        
        # -------------------------------------------------------------
        # STEP 1: VALIDATE SOURCE
        # -------------------------------------------------------------
        if mode == "offline":
            yield "INFO", f"Calculating .iso hash ({self.iso_size // (1024 * 1024)} MB)...", False
            try:
                proc = subprocess.Popen(
                    ["sudo", "head", "-c", str(self.iso_size), self.boot_main_device],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE
                )
                sha = hashlib.sha256()
                bytes_read = 0
                last_yield = 0
                while bytes_read < self.iso_size:
                    chunk_to_read = min(4 * 1024 * 1024, self.iso_size - bytes_read)
                    chunk = proc.stdout.read(chunk_to_read)
                    if not chunk:
                        break
                    sha.update(chunk)
                    bytes_read += len(chunk)
                    now = time.time()
                    if now - last_yield >= 1.0:
                        mb_done = bytes_read // (1024 * 1024)
                        mb_total = self.iso_size // (1024 * 1024)
                        pct = (bytes_read * 100 // self.iso_size)
                        yield "INFO", f"Calculating .iso hash: {mb_done} MB of {mb_total} MB ({pct}%)", True
                        last_yield = now
                proc.stdout.close()
                proc.wait()
                offline_sha256 = sha.hexdigest().lower()
            except Exception as e:
                yield "ERROR", f"Failed to compute SHA256 on {self.boot_main_device}: {e}", False
                return

            yield "INFO", f"Source .iso SHA256: {offline_sha256}", False
            if not (offline_sha256.startswith("c0de") and offline_sha256.endswith("cafe")):
                yield "ERROR", f"Source ISO hash check failed! Source device may be corrupted. Installation stopped.", False
                return

            target_iso_name = self.image_name

        else:
            # Online Mode
            if self.online_update_info:
                latest_update = self.online_update_info
            else:
                default_ini = os.path.join(self.storage.asset_folder, "TempOS.ini.default")
                update_url = ""
                if os.path.exists(default_ini):
                    with open(default_ini, 'r') as f:
                        for line in f:
                            line_s = line.strip()
                            if line_s.lower().startswith("updateurl="):
                                update_url = line_s.split("=", 1)[1].strip()
                                break
                                
                if not update_url:
                    yield "ERROR", f"No updateurl found in {default_ini}", False
                    return
                    
                yield "INFO", f"Fetching update info from {update_url}...", False
                updates = check_online_update(update_url)
                if not updates:
                    yield "ERROR", "No valid update items found at update URL.", False
                    return
                    
                def _sort_key(s):
                    return re.sub(r'(\d+)', lambda m: m.group(1).zfill(10), str(s))
                    
                updates.sort(key=lambda x: _sort_key(x['name']), reverse=True)
                latest_update = updates[0]

            target_iso_name = f"{latest_update['name']}.iso"
            yield "INFO", f"Selected online version: {latest_update['name']}", False

        # -------------------------------------------------------------
        # STEP 2: INSTALL VENTOY ON DESTINATION DRIVE
        # -------------------------------------------------------------
        ventoy_dir = "/Apps/Ventoy"
        if not os.path.exists(ventoy_dir):
            yield "ERROR", f"Ventoy tools directory {ventoy_dir} not found.", False
            return
            
        yield "INFO", f"Unmounting all partitions on {main_device}...", False
        for part in self.storage.partitions:
            if part.get('MainDevice') == main_device and part.get('IsMounted'):
                part_dev = part.get('PartitionDevice')
                if part_dev:
                    run_cmd(f"umount {part_dev}", as_root=True)
                
        run_cmd("sync")
        time.sleep(1)
        
        yield "INFO", f"Installing Ventoy to {main_device}...", False
        orig_cwd = os.getcwd()
        try:
            os.chdir(ventoy_dir)
            cmd = f"./Ventoy2Disk.sh -I {main_device} -L TempOS"
            out = run_cmd(cmd, as_root=True, input_text="y\ny")
            if "Install Ventoy to" not in out and "successfully" not in out:
                yield "ERROR", f"Ventoy installation failed. Output:\n{out}", False
                return
        finally:
            os.chdir(orig_cwd)
            
        yield "INFO", "Waiting for destination disk to appear...", False
        run_cmd("sync")
        time.sleep(6)
        run_cmd("udevadm trigger", as_root=True)
        time.sleep(2)

        # -------------------------------------------------------------
        # STEP 3: FIND AND MOUNT TempOS PARTITION
        # -------------------------------------------------------------
        dest_partition = None
        for _ in range(6):
            self.storage.refresh()
            for p in self.storage.partitions:
                if p.get('MainDevice') == main_device and p.get('VolumeName') == 'TempOS':
                    dest_partition = p.get('PartitionDevice')
                    break
            if dest_partition:
                break
            time.sleep(1)

        if not dest_partition:
            yield "ERROR", f"Could not find 'TempOS' partition on {main_device} after Ventoy installation.", False
            return

        yield "INFO", f"Mounting destination partition {dest_partition}...", False
        if os.path.ismount(dest_mount):
            run_cmd(f"umount {dest_mount}", as_root=True)
            
        run_cmd(f"mkdir -p '{dest_mount}'", as_root=True)
        run_cmd(f"chown 1000:1000 '{dest_mount}'", as_root=True)
        
        mount_res = run_cmd(f"mount {dest_partition} {dest_mount} -o rw,uid=1000,gid=1000", as_root=True)
        if not os.path.ismount(dest_mount):
            yield "ERROR", f"Failed to mount {dest_partition} to {dest_mount}: {mount_res}", False
            return

        run_cmd(f"chown 1000:1000 '{dest_mount}'", as_root=True)

        # -------------------------------------------------------------
        # STEP 4: CONFIGURE VENTOY ASSETS AND ventoy.json
        # -------------------------------------------------------------
        yield "INFO", "Configuring Ventoy on destination...", False
        if not os.path.exists(dest_ventoy_dir):
            os.makedirs(dest_ventoy_dir, exist_ok=True)
            
        src_ventoy_assets = os.path.join(self.storage.asset_folder, "ventoy")
        if os.path.exists(src_ventoy_assets):
            for item in os.listdir(src_ventoy_assets):
                s = os.path.join(src_ventoy_assets, item)
                d = os.path.join(dest_ventoy_dir, item)
                if os.path.isdir(s):
                    if os.path.exists(d):
                        shutil.rmtree(d)
                    shutil.copytree(s, d)
                else:
                    shutil.copy2(s, d)

        iso_rel_path = f"/{self.brand_name}/{target_iso_name}"
        tmpl_path = os.path.join(self.storage.asset_folder, "ventoy.json.template")
        if os.path.exists(tmpl_path):
            try:
                with open(tmpl_path, 'r') as f:
                    v_content = f.read()
                v_content = v_content.replace("{DefaultImage}", iso_rel_path)
                with open(dest_ventoy_json, 'w') as f:
                    f.write(v_content)
            except Exception as e:
                yield "ERROR", f"Failed to create ventoy.json: {e}", False
                return
        else:
            default_vjson = os.path.join(self.storage.asset_folder, "ventoy.json.default")
            if os.path.exists(default_vjson):
                shutil.copy2(default_vjson, dest_ventoy_json)

        run_cmd(f"chown -R 1000:1000 '{dest_ventoy_dir}'", as_root=True)

        # -------------------------------------------------------------
        # STEP 5: CREATE BRAND DIRECTORY AND INSTALL ISO
        # -------------------------------------------------------------
        os.makedirs(brand_dir, exist_ok=True)
        dest_iso_path = os.path.join(brand_dir, target_iso_name)
        dest_iso_part = dest_iso_path + ".part"
        dest_sha_path = dest_iso_path + ".sha256"

        for p in [dest_iso_part, dest_sha_path]:
            if os.path.exists(p):
                os.remove(p)

        if mode == "offline":
            yield "INFO", f"Copying ISO from {self.boot_main_device} ({self.iso_size // (1024 * 1024)} MB)...", False
            try:
                proc = subprocess.Popen(
                    ["sudo", "head", "-c", str(self.iso_size), self.boot_main_device],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE
                )
                bytes_written = 0
                last_yield = 0
                with open(dest_iso_part, "wb") as f_out:
                    while bytes_written < self.iso_size:
                        chunk_to_read = min(4 * 1024 * 1024, self.iso_size - bytes_written)
                        chunk = proc.stdout.read(chunk_to_read)
                        if not chunk:
                            break
                        f_out.write(chunk)
                        bytes_written += len(chunk)
                        now = time.time()
                        if now - last_yield >= 1.0:
                            mb_done = bytes_written // (1024 * 1024)
                            mb_total = self.iso_size // (1024 * 1024)
                            pct = (bytes_written * 100 // self.iso_size)
                            yield "INFO", f"Copying image: {mb_done} MB of {mb_total} MB ({pct}%)", True
                            last_yield = now
                proc.stdout.close()
                proc.wait()
            except Exception as e:
                yield "ERROR", f"Failed copying ISO: {e}", False
                return
                
            os.rename(dest_iso_part, dest_iso_path)
            with open(dest_sha_path, 'w') as f:
                f.write(offline_sha256)
                
            run_cmd("sync")
            time.sleep(1)
            yield "INFO", "Verifying installed image...", False
            run_cmd("sh -c 'echo 3 > /proc/sys/vm/drop_caches'", as_root=True)
            ok, actual_hash = self._verify_file_sha256(dest_iso_path, offline_sha256)
            if not ok:
                yield "ERROR", f"Destination ISO verification failed! (Calculated: {actual_hash}, Expected: {offline_sha256})", False
                return

        else:
            # Online Mode
            yield "INFO", f"Downloading {target_iso_name}...", False
            for res in self._download_with_progress(latest_update['iso_url'], dest_iso_part, "Downloading image"):
                yield "INFO", res[0], res[1]

            run_cmd("sync")
            time.sleep(1)

            yield "INFO", "Verifying downloaded image...", False
            with open(dest_iso_part + ".sha256", 'w') as f:
                f.write(latest_update['iso_hash'])
                
            ok, actual_hash = self._verify_file_sha256(dest_iso_part, latest_update['iso_hash'])
            if not ok:
                yield "ERROR", f"ISO download verification failed! (Calculated: {actual_hash}, Expected: {latest_update['iso_hash']})", False
                return

            os.rename(dest_iso_part, dest_iso_path)
            if os.path.exists(dest_iso_part + ".sha256"):
                os.rename(dest_iso_part + ".sha256", dest_sha_path)

            if latest_update.get('zip_url'):
                zip_name = f"{latest_update['name']}.zip"
                dest_zip = os.path.join(brand_dir, zip_name)
                dest_zip_part = dest_zip + ".part"
                
                yield "INFO", "Downloading external files...", False
                for res in self._download_with_progress(latest_update['zip_url'], dest_zip_part, "Downloading external files"):
                    yield "INFO", res[0], res[1]

                yield "INFO", "Verifying external files...", False
                with open(dest_zip_part + ".sha256", 'w') as f:
                    f.write(latest_update['zip_hash'])
                    
                ok, actual_hash = self._verify_file_sha256(dest_zip_part, latest_update['zip_hash'])
                if not ok:
                    yield "ERROR", f"External files verification failed! (Calculated: {actual_hash})", False
                    return

                os.rename(dest_zip_part, dest_zip)
                
                yield "INFO", "Extracting external files...", False
                try:
                    shutil.unpack_archive(dest_zip, brand_dir)
                except Exception as e:
                    yield "ERROR", f"Failed to extract external files: {e}", False
                    return
                finally:
                    if os.path.exists(dest_zip):
                        os.remove(dest_zip)
                    if os.path.exists(dest_zip_part + ".sha256"):
                        os.remove(dest_zip_part + ".sha256")

        # -------------------------------------------------------------
        # STEP 6: CREATE STRUCTURE & SETTINGS
        # -------------------------------------------------------------
        yield "INFO", "Setting up folders and scripts...", False
        
        apps_ext_dir = os.path.join(brand_dir, "AppsExt")
        scripts_dir = os.path.join(apps_ext_dir, "scripts")
        os.makedirs(scripts_dir, exist_ok=True)

        readme_src = os.path.join(self.storage.asset_folder, "AppsExt_Readme.md")
        if os.path.exists(readme_src):
            shutil.copy2(readme_src, os.path.join(apps_ext_dir, "Readme.md"))

        default_ini = os.path.join(self.storage.asset_folder, "TempOS.ini.default")
        if os.path.exists(default_ini):
            try:
                with open(default_ini, 'r') as f:
                    for line in f:
                        line = line.strip()
                        if line.startswith("folder="):
                            val = line.split("=", 1)[1].strip()
                            if val:
                                folder_name = val.split()[0].strip()
                                if folder_name:
                                    os.makedirs(os.path.join(brand_dir, folder_name), exist_ok=True)
            except Exception:
                pass

        dest_ini = os.path.join(brand_dir, "TempOS.ini")
        if os.path.exists(default_ini):
            shutil.copy2(default_ini, dest_ini)
            
        run_cmd(f"chown -R 1000:1000 '{brand_dir}'", as_root=True)

        # -------------------------------------------------------------
        # STEP 7: CLEANUP, SYNC, UNMOUNT
        # -------------------------------------------------------------
        yield "INFO", "Flushing cache...", False
        time.sleep(1)
        run_cmd("sync")
        
        yield "INFO", "Unmounting destination partition...", False
        run_cmd(f"umount {dest_mount}", as_root=True)
        run_cmd("sync")
        
        if dest_drive.get('IsRemovable'):
            yield "SUCCESS", f"Installation to {main_device} completed successfully. The drive can be removed.", False
        else:
            yield "SUCCESS", f"Installation to {main_device} completed successfully.", False


def main():
    app = InstallTemposApp()
    app.mainloop()


if __name__ == "__main__":
    main()