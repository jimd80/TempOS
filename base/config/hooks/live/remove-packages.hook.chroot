set -e
echo "Removing unwanted packages"
apt -y purge firefox-esr
apt -y purge xiccd
apt -y purge light-locker
#apt -y purge xfce4-power-manager
apt -y purge xserver-xorg-video-intel
#apt -y purge kdeconnect
apt -y purge avahi-daemon
apt -y autoremove
